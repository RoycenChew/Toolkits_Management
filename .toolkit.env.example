# Copy to `.toolkit.env` (git-ignored) and fill in one key.
#
# Looked up by toolkit/provider/resolve.py as DEFAULT_ENV_FILE = ".toolkit.env",
# relative to the WORKING DIRECTORY of the process - not to this repository. Run
# your commands from the directory that holds the file, or pass env_file=.
#
# The real environment overrides this file, never the other way around: the file
# is what you keep on your own machine, the environment is what CI injects, and
# the injected value has to win.
#
# FDIP uses DeepSeek (CLAUDE.md section 2.4). This one line is enough - style,
# endpoint and model all come from the shortcut table:
DEEPSEEK_API_KEY=sk-replace-me

# Optional: override the model the shortcut chose (default deepseek-flash).
# TOOLKIT_MODEL=deepseek-flash

# Or point at any OpenAI-compatible endpoint instead of using a shortcut:
# TOOLKIT_API_KEY=sk-...
# TOOLKIT_BASE_URL=https://your-host/v1
# TOOLKIT_MODEL=your-model-name
